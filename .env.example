# Gmail SMTP credentials for the /api/contact form.
# Use a Gmail App Password (Google Account -> Security -> 2-Step Verification -> App passwords),
# NOT your normal account password (Google rejects plain passwords over SMTP).
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Where contact-form emails are delivered. Optional; defaults to GMAIL_USER.
CONTACT_TO=you@gmail.com

# ── Blog / CMS ──────────────────────────────────────────────────────────────

# Supabase Postgres for Drizzle. Runtime uses the TRANSACTION POOLER (port 6543).
# Find both under Supabase → Project → Connect → ORMs / Connection string.
DATABASE_URL=postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres
# DIRECT connection (port 5432) — used only by drizzle-kit for migrations/DDL.
DIRECT_URL=postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# Admin auth (single admin). Generate the hash with: pnpm hash-password '<password>'
AUTH_SECRET=generate-a-32+-byte-random-string
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH=$2a$10$...bcrypt-hash...

# Supabase Storage for cover-image uploads (server-side, service role ONLY —
# never expose the service-role key to the client). Create a public bucket.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=blog-covers
